<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.anorys.pmm</groupId>
        <artifactId>pmm-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pmm-maven</artifactId>
    <name>pmm-maven</name>
    <description>Reads the POMs of the workspace without running Maven, and checks dependencies against Nexus.</description>

    <dependencies>
        <dependency>
            <groupId>com.anorys.pmm</groupId>
            <artifactId>pmm-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.anorys.pmm</groupId>
            <artifactId>pmm-config</artifactId>
        </dependency>
        <!-- Plain XML parsing of pom.xml files; no dependency injection, so it compiles natively as is. -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-model</artifactId>
        </dependency>
        <!-- settings.xml (Nexus URL and credentials) and Maven's version ordering; plain classes as well. -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-settings</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-artifact</artifactId>
        </dependency>
    </dependencies>
</project>
